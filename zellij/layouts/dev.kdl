layout {
	tab name="editor" focus=true hide_floating_panes=true{

		pane size=1 borderless=true {
			plugin location="zjstatus"
		}
		pane borderless=true command="nvim"
		floating_panes {
			pane
		}
	}

	tab name="extra" {
		pane size=1 borderless=true {
			plugin location="zjstatus"
		}
		pane split_direction="vertical"{
			pane
			pane
			pane
		}
	}
}
