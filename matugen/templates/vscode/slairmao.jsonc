	},
	"tokenColors": [
		{
			"scope": [
				"comment",
				"punctuation.definition.comment"
			],
			"settings": {
				"foreground": "#E8C261",
				"fontStyle": "italic"
			}
		},
		{
			"scope": [
				"variable",
				"string constant.other.placeholder",
				"entity.name.variable.parameter",
				"entity.name.variable.local",
				"variable.parameter"
			],
			"settings": {
				"foreground": "#9DCAFF"
			}
		},
		{
			"scope": [
				"variable.other.object.property"
			],
			"settings": {
				"foreground": "#79D7C0"
			}
		},
		{
			"scope": [
				"constant.other.color"
			],
			"settings": {
				"foreground": "#FFB2BF"
			}
		},
		{
			"scope": [
				"invalid",
				"invalid.illegal"
			],
			"settings": {
				"foreground": "#9DCAFF"
			}
		},
		{
			"scope": [
				"invalid.deprecated"
			],
			"settings": {
				"foreground": "#F7B0E9"
			}
		},
		{
			"scope": [
				"keyword",
				"storage.modifier"
			],
			"settings": {
				"foreground": "#7CD2F1"
			}
		},
		{
			"scope": [
				"keyword.control",
				"keyword.control.flow",
				"keyword.control.from",
				"keyword.control.import",
				"keyword.control.as"
			],
			"settings": {
				"foreground": "#7CD2F1"
			}
		},
		{
			"scope": [
				"keyword.other.using",
				"keyword.other.namespace",
				"keyword.other.class",
				"keyword.other.new",
				"keyword.other.event",
				"keyword.other.this",
				"keyword.other.await",
				"keyword.other.var",
				"keyword.other.package",
				"keyword.other.import",
				"variable.language.this",
				"storage.type.ts"
			],
			"settings": {
				"foreground": "#7CD2F1"
			}
		},
		{
			"scope": [
				"keyword.type",
				"storage.type.primitive"
			],
