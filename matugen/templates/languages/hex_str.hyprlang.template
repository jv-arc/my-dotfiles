# Directly generated from matugen for hyprlang
#
# Uses direct strings with hex rgb values so its easy
# to cast them into rgb or rgba depending on the context
#
# template path: ~/.config/matugen/templates/languages/hex_str_hyprlang.template
#


# Background Image:
	$bg_image = {{image}}


# Colors
<* for name, values in colors *>
	${{name}} = {{values.default.hex_stripped}}
	$DARK_{{name}} = {{values.dark.hex_stripped}}
	$LIGHT_{{name}} = {{values.light.hex_stripped}}
<* endfor *>
