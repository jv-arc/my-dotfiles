#!/bin/bash

# Function to sanitize string to ASCII compatible format
sanitize_ascii() {
    local input="$1"
    # Convert to lowercase, replace non-alphanumeric chars with dashes, remove duplicate dashes
    echo "$input" | tr '[:upper:]' '[:lower:]' | \
                   sed -e 's/[^a-z0-9]/-/g' \
                       -e 's/--*/-/g' \
                       -e 's/^-\+\|-\+$//g'
}

# Get current git branch
get_current_branch() {
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git branch --show-current 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown"
    else
        echo "not-a-git-repo"
    fi
}

# Generate timestamp
timestamp=$(date +"%Y%m%d-%H%M%S")

# Get current branch
branch=$(get_current_branch)

# Sanitize branch name
sanitized_branch=$(sanitize_ascii "$branch")

# Create final string with branch and timestamp
result="${sanitized_branch}-${timestamp}"

echo "$result"
